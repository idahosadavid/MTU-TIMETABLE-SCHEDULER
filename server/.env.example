DB_PROVIDER=sqlite
PORT=5000

# Required only when DB_PROVIDER=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Student auth mode: legacy | portal-token
MTU_STUDENT_AUTH_MODE=legacy

# Required when MTU_STUDENT_AUTH_MODE=portal-token
MTU_PORTAL_SHARED_SECRET=
MTU_PORTAL_SESSION_SECRET=
MTU_PORTAL_CODE_TTL_SECONDS=120

# Live MTU Portal API Integration
# Change MTU_STUDENT_DATA_SOURCE to 'api' to fetch live data from the school portal instead of the local DB
MTU_STUDENT_DATA_SOURCE=db
MTU_PORTAL_API_URL=https://studentportal.mtu.edu.ng/api/v1
MTU_PORTAL_API_KEY=
