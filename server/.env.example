DB_PROVIDER=sqlite
PORT=5000

# Required only when DB_PROVIDER=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Student auth mode: legacy | portal-token
MTU_STUDENT_AUTH_MODE=legacy

# Required when MTU_STUDENT_AUTH_MODE=portal-token
MTU_PORTAL_SHARED_SECRET=
MTU_PORTAL_SESSION_SECRET=
MTU_PORTAL_CODE_TTL_SECONDS=120
