DB_PROVIDER=supabase
PORT=5000

# Required only when DB_PROVIDER=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Student auth mode: portal-token (recommended) | legacy (deprecated)
# Direct / manual student login has been removed.
# Students must access their timetable via the MTU Portal SSO redirect.
MTU_STUDENT_AUTH_MODE=portal-token

# Required for portal-token mode
MTU_PORTAL_SHARED_SECRET=
MTU_PORTAL_SESSION_SECRET=
MTU_PORTAL_CODE_TTL_SECONDS=120

# MTU Portal API — REQUIRED for Just-In-Time (JIT) student provisioning.
# Students are auto-created in the local DB on first portal login.
# No manual seeding of student data is needed.
MTU_PORTAL_API_URL=https://studentportal.mtu.edu.ng/api/v1
MTU_PORTAL_API_KEY=

# Admin course sync from portal
# When MTU_PORTAL_API_URL is set, admins can use the "Sync from Portal" button in Course Management
# to pull the live course catalog directly into a timetable.
# The API key is sent as the x-api-key header (optional if the portal endpoint is open to internal services).

# Admin RBAC — required. Set a strong secret; admins enter this as their password at /admin-login.
# Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_API_KEY=

# CORS — REQUIRED in production. Comma-separated list of browser origins allowed
# to call this API (e.g. your deployed frontend). Localhost is always allowed.
# When left empty, ALL origins are allowed (development only).
# Example: CORS_ALLOWED_ORIGINS=https://mtu-timetable.vercel.app
CORS_ALLOWED_ORIGINS=
